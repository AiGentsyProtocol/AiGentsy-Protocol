"""Lifecycle tests for the generated {{PROJECT_NAME}} starter.

Runs with NO network and NO credentials. The starter's `classify_stage`
function is a pure local classifier; these tests pin its behavior on
canonical examples and assert the generated files honor the consent
boundary.
"""

from __future__ import annotations

import json
import sys
from pathlib import Path

import pytest

# Make the generated agent.py importable
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from agent import classify_stage, load_system_prompt, SYSTEM_PROMPT_PATH  # noqa: E402


HERE = Path(__file__).resolve().parent
PROJECT_ROOT = HERE.parent


# ----------------------------------------------------------------------------
# A. Stage classifier — canonical lifecycle assertions
# ----------------------------------------------------------------------------


def test_draft_does_not_recommend_proofpack():
    """Draft / WIP must NOT trigger a ProofPack — drafts are not handoff-ready."""
    r = classify_stage("Still drafting the proposal; nothing delivered yet.")
    assert r["stage"] == "draft"
    assert r["applicable"] is False
    assert r["next_tool"] is None


def test_handoff_ready_recommends_proofpack():
    """Handoff-ready work should recommend creating a ProofPack."""
    r = classify_stage("Finished deliverable for client review; payment pending.")
    assert r["stage"] == "handoff_ready"
    assert r["applicable"] is True
    assert r["next_tool"] == "aigentsy_proof_pack"


def test_verified_not_accepted_does_not_recommend_settlement():
    """Verification is not acceptance — verify path must NOT recommend settle."""
    r = classify_stage("Buyer must verify the proof before paying.")
    assert r["next_tool"] != "aigentsy_settle"
    assert r["next_tool"] == "aigentsy_verify"


def test_accepted_can_recommend_settlement():
    """Accepted work can recommend settlement."""
    r = classify_stage("Counterparty has accepted the work; ready for payout.")
    assert r["stage"] == "accepted"
    assert r["applicable"] is True
    assert r["next_tool"] == "aigentsy_settle"


def test_export_path():
    """External-audit / offline-verification path routes to export, not settle."""
    r = classify_stage("External auditor needs to verify the proof offline.")
    assert r["next_tool"] == "aigentsy_export"


# ----------------------------------------------------------------------------
# B. No outreach / no broadcast in the generated project
# ----------------------------------------------------------------------------


FORBIDDEN_IMPORT_PATTERNS = (
    # actual browser-automation modules
    "from playwright",
    "import playwright",
    "from selenium",
    "import selenium",
    # actual outreach functions from the runtime's social_autoposting_engine
    "post_to_twitter_direct",
    "post_to_instagram_direct",
    "post_to_linkedin_direct",
    "send_sms_direct",
    "social_autoposting_engine",
    # generic message-send identifiers
    "send_dm(",
    "send_dm =",
)


@pytest.mark.parametrize("forbidden_pattern", FORBIDDEN_IMPORT_PATTERNS)
def test_no_outreach_module_referenced_in_python_files(forbidden_pattern):
    """No generated Python file (excluding this test file itself, which
    legitimately enumerates the forbidden patterns as string literals)
    may import or call an outreach module/function.

    Scans .py files only — discussion of these concepts in .md/.json is
    fine (the canonical prompt explicitly disclaims broadcast/outreach;
    that disclaiming is itself one of the load-bearing properties).
    """
    self_file = Path(__file__).resolve()
    py_files = [
        f for f in PROJECT_ROOT.rglob("*.py")
        if f.resolve() != self_file
    ]
    for f in py_files:
        body = f.read_text(encoding="utf-8")
        assert forbidden_pattern not in body, (
            f"forbidden outreach pattern {forbidden_pattern!r} found in {f}"
        )


