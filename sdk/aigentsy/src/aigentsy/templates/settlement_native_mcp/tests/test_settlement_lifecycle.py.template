# ----------------------------------------------------------------------------
# F. Acceptance policy fixture — concrete declarative rules ship in starter
# ----------------------------------------------------------------------------


ACCEPTANCE_POLICY_FIXTURE = PROJECT_ROOT / "acceptance_policy.example.json"


def test_acceptance_policy_fixture_exists():
    """The starter must ship a concrete declarative-rules fixture (not
    just prose). This is what makes 'the template includes a policy
    fixture' true."""
    assert ACCEPTANCE_POLICY_FIXTURE.is_file(), (
        f"acceptance_policy.example.json missing: {ACCEPTANCE_POLICY_FIXTURE}"
    )


def test_acceptance_policy_fixture_parses_as_json():
    body = ACCEPTANCE_POLICY_FIXTURE.read_text(encoding="utf-8")
    spec = json.loads(body)
    assert isinstance(spec, dict)
    assert "rules" in spec and isinstance(spec["rules"], list)
    assert spec.get("default_action") in {"auto_accept", "require_review", "auto_reject"}


def test_acceptance_policy_fixture_uses_starter_fields():
    """Every rule condition references a field from the canonical starter
    triple — tests_passed, rollback_plan_present, reviewer_approval —
    proving the fixture is wired to the runtime ALLOWED_FIELDS additions."""
    spec = json.loads(ACCEPTANCE_POLICY_FIXTURE.read_text(encoding="utf-8"))
    starter_fields = {"tests_passed", "rollback_plan_present", "reviewer_approval"}
    seen_fields = set()
    for rule in spec["rules"]:
        for cond in rule.get("conditions", []):
            field = cond.get("field")
            assert field in starter_fields, (
                f"fixture rule references non-starter field: {field!r}"
            )
            seen_fields.add(field)
    # All three starter fields must appear at least once.
    assert seen_fields == starter_fields, (
        f"fixture must exercise all three starter fields, got {seen_fields}"
    )


def test_acceptance_policy_fixture_has_reject_path():
    """At least one rule must declare auto_reject — the load-bearing
    'verified but rejected' path."""
    spec = json.loads(ACCEPTANCE_POLICY_FIXTURE.read_text(encoding="utf-8"))
    actions = [r.get("action") for r in spec["rules"]]
    assert "auto_reject" in actions, (
        "fixture must include at least one auto_reject rule"
    )


def test_acceptance_policy_fixture_default_is_conservative():
    """default_action must be require_review — never auto_accept by
    default. Conservative posture: when no rule matches, a human looks."""
    spec = json.loads(ACCEPTANCE_POLICY_FIXTURE.read_text(encoding="utf-8"))
    assert spec.get("default_action") == "require_review", (
        f"default_action must be require_review, got {spec.get('default_action')!r}"
    )


def test_acceptance_policy_fixture_uses_allowed_ops():
    """Every condition uses only allow-listed operators."""
    spec = json.loads(ACCEPTANCE_POLICY_FIXTURE.read_text(encoding="utf-8"))
    allowed_ops = {">=", "<=", "==", "!=", ">", "<", "in"}
    for rule in spec["rules"]:
        for cond in rule.get("conditions", []):
            assert cond.get("op") in allowed_ops, (
                f"condition uses unsupported op: {cond.get('op')!r}"
            )
