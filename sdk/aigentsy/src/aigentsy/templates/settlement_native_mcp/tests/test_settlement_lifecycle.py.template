# ----------------------------------------------------------------------------
# D. MCP config contains no real credentials
# ----------------------------------------------------------------------------


def test_mcp_config_has_no_real_credentials():
    cfg = json.loads((PROJECT_ROOT / "mcp_config.example.json").read_text())
    env = cfg["mcpServers"]["aigentsy"]["env"]
    # The placeholder must be the literal placeholder, not a real key
    assert env.get("AIGENTSY_API_KEY") == "your_api_key_here", (
        "AIGENTSY_API_KEY must remain a placeholder, never a real credential"
    )
    # No accidental Twitter / Stripe / etc. credentials
    for key in env:
        assert not key.startswith("STRIPE_"), f"unexpected real-credential key: {key}"
        assert not key.startswith("TWITTER_"), f"unexpected real-credential key: {key}"
        assert not key.startswith("LINKEDIN_"), f"unexpected real-credential key: {key}"


def test_mcp_config_uses_verified_invocation():
    """The example MCP config must use the verified `python -m adapters.mcp_server`
    invocation — the same one that ships in aigentsy-mcp-example/."""
    cfg = json.loads((PROJECT_ROOT / "mcp_config.example.json").read_text())
    server = cfg["mcpServers"]["aigentsy"]
    assert server["command"] == "python"
    assert server["args"] == ["-m", "adapters.mcp_server"]


