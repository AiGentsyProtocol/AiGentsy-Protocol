# C. Canonical clauses are present in agent_system_prompt.md
# ----------------------------------------------------------------------------


@pytest.mark.parametrize(
    "required_clause",
    [
        "Verification is not acceptance",
        "Do not create ProofPacks for every draft",
        "Do not contact unaffiliated agents",
        "Settlement happens only after proof and acceptance",
        "Do not broadcast",
    ],
)
def test_required_clause_in_system_prompt(required_clause):
    body = load_system_prompt()
    assert required_clause in body, (
        f"canonical clause missing from agent_system_prompt.md: {required_clause!r}"
