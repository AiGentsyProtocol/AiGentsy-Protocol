"""

from __future__ import annotations

import json
from pathlib import Path

HERE = Path(__file__).resolve().parent
SYSTEM_PROMPT_PATH = HERE / "agent_system_prompt.md"


# ----------------------------------------------------------------------------
# Stage classifier
# ----------------------------------------------------------------------------
#
# Pure local logic. No model call. No network. Matches the conservative
# posture of the canonical aigentsy_settlement_signal advisory meta-tool.

HANDOFF_TRIGGERS = (
    "finished deliverable",
    "ready for client review",
    "ready for handoff",
    "ready for payment",
    "ready for release",
    "ready for deployment",
    "shipped",
    "delivered",
)

VERIFY_TRIGGERS = (
    "must verify",
    "verify before pay",
    "verify before deploy",
    "counterparty must verify",
)

ACCEPTED_TRIGGERS = (
    "accepted",
    "approved by counterparty",
    "ready for payout",
    "ready to settle",
)

EXPORT_TRIGGERS = (
    "external auditor",
    "offline verification",
    "archive proof",
    "partner verification",
)

DRAFT_TRIGGERS = (
    "brainstorm",
    "draft",
    "wip",
    "work in progress",
    "planning",
    "in progress",
    "internal notes",
    "nothing delivered yet",
)


def classify_stage(work_summary: str) -> dict:
    """Classify a work summary into a settlement-relevant stage.

    Returns a dict with: stage, applicable, next_tool, rationale.

    Conservative by design: returns applicable=False ('draft / no settlement
    action') unless explicit handoff / verification / accepted / export
    triggers are present and no draft trigger overrides them.
    """
    s = work_summary.lower()

    # Draft / WIP overrides every other classification — the conservative bias.
    if any(trigger in s for trigger in DRAFT_TRIGGERS):
        return {
            "stage": "draft",
            "applicable": False,
            "next_tool": None,
            "rationale": "Draft/WIP language detected. No ProofPack. No settlement.",
        }

    if any(trigger in s for trigger in ACCEPTED_TRIGGERS):
        return {
            "stage": "accepted",
            "applicable": True,
            "next_tool": "aigentsy_settle",
            "rationale": "Counterparty has accepted. Settlement can proceed.",
        }

    if any(trigger in s for trigger in VERIFY_TRIGGERS):
        return {
            "stage": "verification_needed",
            "applicable": True,
            "next_tool": "aigentsy_verify",
            "rationale": (
                "Counterparty needs to verify the proof. "
                "Verification is NOT acceptance — acceptance is a separate gate."
            ),
        }

    if any(trigger in s for trigger in EXPORT_TRIGGERS):
        return {
            "stage": "export",
            "applicable": True,
            "next_tool": "aigentsy_export",
            "rationale": "Proof must travel outside the originating app.",
        }

    if any(trigger in s for trigger in HANDOFF_TRIGGERS):
        return {
            "stage": "handoff_ready",
            "applicable": True,
            "next_tool": "aigentsy_proof_pack",
            "rationale": "Handoff-ready work. Create a ProofPack before reliance.",
        }

    return {
        "stage": "no_action",
        "applicable": False,
        "next_tool": None,
        "rationale": "No settlement-relevant triggers detected.",
    }


# ----------------------------------------------------------------------------
# Local demo
# ----------------------------------------------------------------------------


SAMPLE_WORK_SUMMARIES = [
    ("DRAFT", "Still drafting the proposal; nothing delivered yet."),
    ("HANDOFF_READY", "Finished deliverable for client review; payment pending."),
    ("VERIFIED_NOT_ACCEPTED", "Buyer must verify the proof before paying."),
    ("ACCEPTED", "Counterparty has accepted the work; ready for payout."),
]


def load_system_prompt() -> str:
    return SYSTEM_PROMPT_PATH.read_text(encoding="utf-8")


def demo() -> None:
    print("=" * 72)
    print("{{PROJECT_NAME}} — settlement-native agent starter (local demo)")
    print("=" * 72)
    print()
    print("System prompt loaded from:", SYSTEM_PROMPT_PATH)
    print("Lines in system prompt:   ", len(load_system_prompt().splitlines()))
    print()
    print("This demo performs ZERO network calls and creates ZERO real")
    print("ProofPacks. It only classifies sample work summaries against the")
    print("canonical lifecycle and names which AiGentsy MCP tool would")
    print("apply at each stage. Inside an authorized MCP session you would")
    print("call those tools; here we only describe them.")
    print()

    for label, summary in SAMPLE_WORK_SUMMARIES:
        verdict = classify_stage(summary)
        print(f"[{label}]")
        print(f"  summary:    {summary}")
        print(f"  stage:      {verdict['stage']}")
        print(f"  applicable: {verdict['applicable']}")
        print(f"  next_tool:  {verdict['next_tool']}")
        print(f"  rationale:  {verdict['rationale']}")
        print()

    print("Done. No network call was made. No ProofPack was created.")
    print()
    print("Next: connect the AiGentsy MCP server to your host and call the")
    print("named tools inside an authorized session.")
    print("See https://aigentsy.com/mcp-setup")


if __name__ == "__main__":
    demo()
